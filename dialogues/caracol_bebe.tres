[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" path="res://UI/dialogo/dialogue_data.gd" id="1_data"]
[ext_resource type="Script" path="res://UI/dialogo/dialogue_line.gd" id="2_line"]
[ext_resource type="Resource" path="res://dialogues/personagens/caracol_bebe.tres" id="3_char"]

[sub_resource type="Resource" id="Resource_fala1"]
script = ExtResource("2_line")
personagem = ExtResource("3_char")
expressao = "surpreso"
texto = "Você é novo!"

[sub_resource type="Resource" id="Resource_fala2"]
script = ExtResource("2_line")
personagem = ExtResource("3_char")
expressao = "neutro"
texto = "Todo mundo aqui é novo, até parar de ser."

[sub_resource type="Resource" id="Resource_fala3"]
script = ExtResource("2_line")
personagem = ExtResource("3_char")
expressao = "neutro"
texto = "Minha mãe falou com você?"

[sub_resource type="Resource" id="Resource_fala4"]
script = ExtResource("2_line")
personagem = ExtResource("3_char")
expressao = "feliz"
texto = "Ela fala com todos."

[resource]
script = ExtResource("1_data")
falas = Array[ExtResource("2_line")]([SubResource("Resource_fala1"), SubResource("Resource_fala2"), SubResource("Resource_fala3"), SubResource("Resource_fala4")])
