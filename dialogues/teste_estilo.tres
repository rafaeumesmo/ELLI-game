[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" path="res://UI/dialogo/dialogue_data.gd" id="1_data"]
[ext_resource type="Script" path="res://UI/dialogo/dialogue_line.gd" id="2_line"]
[ext_resource type="Resource" path="res://dialogues/personagens/caracol_bebe.tres" id="3_bebe"]
[ext_resource type="Resource" path="res://dialogues/personagens/elisio.tres" id="4_elisio"]

[sub_resource type="Resource" id="Resource_fala1"]
script = ExtResource("2_line")
personagem = ExtResource("3_bebe")
expressao = "neutro"
texto = "Ei! Você!"

[sub_resource type="Resource" id="Resource_fala2"]
script = ExtResource("2_line")
personagem = ExtResource("4_elisio")
expressao = "surpreso"
texto = "Eu?"

[sub_resource type="Resource" id="Resource_fala3"]
script = ExtResource("2_line")
personagem = ExtResource("3_bebe")
expressao = "feliz"
texto = "[wave]Vagalumes azuis[/wave]... eles sobem até o jardim."

[resource]
script = ExtResource("1_data")
falas = Array[ExtResource("2_line")]([SubResource("Resource_fala1"), SubResource("Resource_fala2"), SubResource("Resource_fala3")])
